{
    "NOTE": "NDP 1-to-10 fan-out 测试: host0 同时向 host[1-10] 各发 100MB，验证带宽饱和、公平性、收敛性",
    "inputFile": {
        "topo": "config/topo/star16.txt"
    },
    "outputFile": {
        "resultFile": "output/ndp-tests/ndp-fanout-1to10/ndp-fanout-1to10-*.json"
    },
    "runtimeConfig": {
        "seed": 42,
        "runningTime": "0.5s",
        "stopTime": "0.5s"
    },
    "defaultConfig": {
        "NdpSocket": {
            "FirstWindowSize": 103,
            "RtoMs": 0.2
        },
        "NdpL4Protocol": {
            "PullMtu": 1456
        },
        "NdpSwitchQueue": {
            "LowQueueMaxPackets": 10,
            "HighQueueMaxPackets": 20000,
            "HighQueueWeight": 10,
            "LowQueueWeight": 1
        }
    },
    "globalConfig": {
        "detailedSenderStats": true,
        "detailedRetxStats": false,
        "detailedQlengthStats": true,
        "qlengthRecordInterval": "100us",
        "detailedThroughputStats": true,
        "deviceThroughputRecordInterval": "100us",
        "ndpTrimStats": true,
        "ndpRtsStats": false
    },
    "topologyConfig": {
        "flowControlConfig": [
            {
                "nodes": "host",
                "trafficControlLayer": "ns3::TrafficControlLayer",
                "trafficControlLayerConfig": {},
                "queueDisc": "ns3::NdpHostQueue",
                "queueDiscConfig": {
                    "MaxPackets": 50000
                }
            },
            {
                "nodes": "switch",
                "bufferSize": "3200MiB",
                "bufferPerPort": "3.2MiB",
                "trafficControlLayer": "ns3::TrafficControlLayer",
                "trafficControlLayerConfig": {},
                "queueDisc": "ns3::NdpSwitchQueue",
                "queueDiscConfig": {
                    "LowQueueMaxPackets": 10,
                    "HighQueueMaxPackets": 20000,
                    "HighQueueWeight": 10,
                    "LowQueueWeight": 1
                }
            }
        ],
        "linkConfig": [
            {
                "links": "0",
                "rate": "100Gbps",
                "delay": "3us"
            }
        ],
        "multipathConfig": {
            "numPaths": 1,
            "baseNetwork": "10.0.0.0",
            "networkMask": "255.255.0.0"
        }
    },
    "applicationConfig": [
