{
    "NOTE": "NDP fat-tree k=4 跨 Pod 交叉 incast: Pod0+Pod1 → Pod2 (8 flows, 2-to-1 per dest)",
    "NOTE2": "拓扑: 16 hosts + 20 switches, 3 层 fat-tree. 流量跨越核心层，在核心交换机和目标叶交换机处产生拥塞与 Trim",
    "inputFile": {
        "topo": "config/topo/fat4.txt"
    },
    "outputFile": {
        "resultFile": "output/ndp-tests/ndp-fat4-crossincast/ndp-fat4-crossincast-*.json"
    },
    "runtimeConfig": {
        "seed": 42,
        "runningTime": "0.1s",
        "stopTime": "0.1s"
    },
    "defaultConfig": {
        "NdpSocket": {
            "FirstWindowSize": 50,
            "RtoMs": 0.5
        },
        "NdpL4Protocol": {
            "PullMtu": 1456
        },
        "NdpSwitchQueue": {
            "LowQueueMaxPackets": 8,
            "HighQueueMaxPackets": 20000,
            "HighQueueWeight": 10,
            "LowQueueWeight": 1
        }
    },
    "globalConfig": {
        "detailedSenderStats": true,
        "detailedRetxStats": false,
        "detailedQlengthStats": true,
        "qlengthRecordInterval": "100us",
        "detailedThroughputStats": true,
        "deviceThroughputRecordInterval": "100us",
        "ndpTrimStats": true,
        "ndpRtsStats": false
    },
    "topologyConfig": {
        "flowControlConfig": [
            {
                "nodes": "host",
                "trafficControlLayer": "ns3::TrafficControlLayer",
                "trafficControlLayerConfig": {},
                "queueDisc": "ns3::NdpHostQueue",
                "queueDiscConfig": {
                    "MaxPackets": 50000
                }
            },
            {
                "nodes": "switch",
                "bufferSize": "3200MiB",
                "bufferPerPort": "3.2MiB",
                "trafficControlLayer": "ns3::TrafficControlLayer",
                "trafficControlLayerConfig": {},
                "queueDisc": "ns3::NdpSwitchQueue",
                "queueDiscConfig": {
                    "LowQueueMaxPackets": 8,
                    "HighQueueMaxPackets": 20000,
                    "HighQueueWeight": 10,
                    "LowQueueWeight": 1
                }
            }
        ],
        "linkConfig": [
            {
                "links": "0",
                "rate": "100Gbps",
                "delay": "1us"
            }
        ],
        "multipathConfig": {
            "numPaths": 1,
            "baseNetwork": "10.0.0.0",
            "networkMask": "255.255.0.0"
        }
    },
    "applicationConfig": [
        {
            "NOTE": "Pod0 → Pod2: Host 0 → Host 8",
            "appType": "ns3::NdpTrafficGenApplication",
            "protocol": "NDP",
            "nodes": "[0]",
            "applicationConfig": {
                "SendEnabled": true,
                "TrafficPattern": "SEND_ONCE",
                "FlowSize": 50000000,
                "DestFixed": true,
                "DestinationNode": 8
            },
            "ndpConfig": { "firstWindowSize": 50, "pullLinkRate": "100Gbps" },
            "multipathConfig": { "numPaths": 1, "pathSelection": "random" },
            "startTime": "0.01s",
            "flowInterval": "0.0000s"
        },
        {
            "NOTE": "Pod0 → Pod2: Host 1 → Host 9",
            "appType": "ns3::NdpTrafficGenApplication",
            "protocol": "NDP",
            "nodes": "[1]",
            "applicationConfig": {
                "SendEnabled": true,
                "TrafficPattern": "SEND_ONCE",
                "FlowSize": 50000000,
                "DestFixed": true,
                "DestinationNode": 9
            },
            "ndpConfig": { "firstWindowSize": 50, "pullLinkRate": "100Gbps" },
            "multipathConfig": { "numPaths": 1, "pathSelection": "random" },
            "startTime": "0.01s",
            "flowInterval": "0.0000s"
        },
        {
            "NOTE": "Pod0 → Pod2: Host 2 → Host 10",
            "appType": "ns3::NdpTrafficGenApplication",
            "protocol": "NDP",
            "nodes": "[2]",
            "applicationConfig": {
                "SendEnabled": true,
                "TrafficPattern": "SEND_ONCE",
                "FlowSize": 50000000,
                "DestFixed": true,
                "DestinationNode": 10
            },
            "ndpConfig": { "firstWindowSize": 50, "pullLinkRate": "100Gbps" },
            "multipathConfig": { "numPaths": 1, "pathSelection": "random" },
            "startTime": "0.01s",
            "flowInterval": "0.0000s"
        },
        {
            "NOTE": "Pod0 → Pod2: Host 3 → Host 11",
            "appType": "ns3::NdpTrafficGenApplication",
            "protocol": "NDP",
            "nodes": "[3]",
            "applicationConfig": {
                "SendEnabled": true,
                "TrafficPattern": "SEND_ONCE",
                "FlowSize": 50000000,
                "DestFixed": true,
                "DestinationNode": 11
            },
            "ndpConfig": { "firstWindowSize": 50, "pullLinkRate": "100Gbps" },
            "multipathConfig": { "numPaths": 1, "pathSelection": "random" },
            "startTime": "0.01s",
