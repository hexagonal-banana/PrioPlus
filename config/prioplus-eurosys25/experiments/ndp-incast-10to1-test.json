{
    "NOTE": "NDP 10-to-1 incast 测试: 10条100MB大流 host[0-9]→host10，验证带宽饱和、公平性、收敛性",
    "inputFile": {
        "topo": "config/topo/star16.txt"
    },
    "outputFile": {
        "resultFile": "output/ndp-tests/ndp-incast-10to1/ndp-incast-10to1-*.json"
    },
    "runtimeConfig": {
        "seed": 42,
        "runningTime": "0.5s",
        "stopTime": "0.5s"
    },
    "defaultConfig": {
        "NdpSocket": {
            "FirstWindowSize": 103,
            "RtoMs": 0.1
        },
        "NdpL4Protocol": {
            "PullMtu": 1456
        },
        "NdpSwitchQueue": {
            "LowQueueMaxPackets": 10,
            "HighQueueMaxPackets": 20000,
            "HighQueueWeight": 10,
            "LowQueueWeight": 1
        }
    },
    "globalConfig": {
        "detailedSenderStats": true,
        "detailedRetxStats": false,
        "detailedQlengthStats": false,
        "qlengthRecordInterval": "100us",
        "detailedThroughputStats": true,
        "deviceThroughputRecordInterval": "100us",
        "ndpTrimStats": true,
        "ndpRtsStats": false
    },
    "topologyConfig": {
        "flowControlConfig": [
            {
                "nodes": "host",
                "trafficControlLayer": "ns3::TrafficControlLayer",
                "trafficControlLayerConfig": {},
                "queueDisc": "ns3::NdpHostQueue",
                "queueDiscConfig": {
                    "MaxPackets": 50000
                }
            },
            {
                "nodes": "switch",
                "bufferSize": "3200MiB",
                "bufferPerPort": "3.2MiB",
                "trafficControlLayer": "ns3::TrafficControlLayer",
                "trafficControlLayerConfig": {},
                "queueDisc": "ns3::NdpSwitchQueue",
                "queueDiscConfig": {
                    "LowQueueMaxPackets": 10,
                    "HighQueueMaxPackets": 20000,
                    "HighQueueWeight": 10,
                    "LowQueueWeight": 1
                }
            }
        ],
        "linkConfig": [
            {
                "links": "0",
                "rate": "100Gbps",
                "delay": "3us"
            }
        ],
        "multipathConfig": {
            "numPaths": 1,
            "baseNetwork": "10.0.0.0",
            "networkMask": "255.255.0.0"
        }
    },
    "applicationConfig": [
        {
            "NOTE": "10个发送方: host[0-9] → host10，每个发送100MB大流",
            "appType": "ns3::NdpTrafficGenApplication",
            "protocol": "NDP",
            "nodes": "[0:10]",
            "applicationConfig": {
                "SendEnabled": true,
                "TrafficPattern": "SEND_ONCE",
                "FlowSize": 100000000,
                "DestFixed": true,
                "DestinationNode": 10
            },
            "ndpConfig": {
                "firstWindowSize": 103,
                "pullLinkRate": "100Gbps"
            },
            "multipathConfig": {
                "numPaths": 1,
                "pathSelection": "random"
            },
            "startTime": "0.1s",
            "flowInterval": "0.0000s"
        },
        {
            "NOTE": "接收方: host10，pullLinkRate 控制 PULL 总速率（所有流共享）",
            "appType": "ns3::NdpTrafficGenApplication",
            "protocol": "NDP",
            "nodes": "[10]",
            "applicationConfig": {
                "SendEnabled": false
            },
            "ndpConfig": {
                "pullLinkRate": "100Gbps"
            },
            "startTime": "0.1s"
        }
    ]
}
